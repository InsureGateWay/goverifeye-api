NODE_ENV=development
PORT=3001
API_PREFIX=api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goverifeye
DATABASE_TYPE=postgres
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_LOGGING=false
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
VERIFICATION_CODE_LENGTH=16
ACTIVATION_CODE_LENGTH=8
ACTIVATION_MAX_ATTEMPTS=5
MAX_CODES_PER_BATCH=10000
CODE_ACTIVATION_PEPPER=replace-with-an-independent-32-character-secret
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-offline-refresh-token
GMAIL_USER_ID=me
GMAIL_FROM_EMAIL=replace-with-authorized-gmail-address
GMAIL_FROM_NAME=goVerifEye
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
APP_PUBLIC_URL=http://localhost:5173
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=compliance-documents
SUPABASE_ARTIFACT_BUCKET=generated-artifacts
ARTIFACT_DOWNLOAD_TTL_SECONDS=3600
STORAGE_DOWNLOAD_TTL_SECONDS=300
MALWARE_SCAN_REQUIRED=true
MALWARE_SCANNER_URL=replace-with-malware-scanner-endpoint
MALWARE_SCANNER_API_KEY=replace-with-malware-scanner-api-key
