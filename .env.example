NODE_ENV=development
LOG_FORMAT=pretty
LOG_LEVEL=log
PORT=3001
API_PREFIX=api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goverifeye
DATABASE_TYPE=postgres
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_LOGGING=false
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX=10
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
VERIFICATION_CODE_LENGTH=16
ACTIVATION_CODE_LENGTH=8
ACTIVATION_MAX_ATTEMPTS=5
MAX_CODES_PER_BATCH=10000
CODE_ACTIVATION_PEPPER=replace-with-an-independent-32-character-secret
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=replace-with-resend-api-key
SMTP_FROM_EMAIL=noreply@mail.zigoai.app
SMTP_FROM_NAME=goVerifEye
EMAIL_SUPPORT_ADDRESS=support@goverifeye.com
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
APP_PUBLIC_URL=http://localhost:5173
TERMS_AND_CONDITIONS_URL=http://localhost:5173/terms-and-conditions
USER_GUIDE_URL=http://localhost:5173/user-guide
DATA_USE_POLICY_URL=http://localhost:5173/data-use-policy
TERMS_VERSION=2026-07-25
DATA_USE_POLICY_VERSION=2026-07-25
AUDIT_METADATA_PEPPER=replace-with-an-independent-32-character-secret
DEMO_AUTO_APPROVE_ONBOARDING=false
SEED_VENDOR_EMAIL=vendor.demo@goverifeye.test
SEED_VENDOR_PASSWORD=Vendor123!
SEED_VENDOR_FIRST_NAME=Demo
SEED_VENDOR_LAST_NAME=Vendor
SEED_VENDOR_COMPANY_NAME=goVerifEye Demo Vendor Ltd
SEED_VENDOR_REGISTRATION_NUMBER=DEMO-RC-0001
SEED_PLATFORM_ADMIN_EMAIL=senorleo12@yahoo.com
SEED_PLATFORM_ADMIN_PASSWORD=replace-with-a-render-secret
SEED_PLATFORM_ADMIN_FIRST_NAME=Super
SEED_PLATFORM_ADMIN_LAST_NAME=Admin
SEED_PLATFORM_ADMIN_RESET_PASSWORD=false
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=compliance-documents
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images
SUPABASE_ARTIFACT_BUCKET=generated-artifacts
ARTIFACT_DOWNLOAD_TTL_SECONDS=3600
STORAGE_DOWNLOAD_TTL_SECONDS=300
MALWARE_SCAN_REQUIRED=true
MALWARE_SCANNER_URL=replace-with-malware-scanner-endpoint
MALWARE_SCANNER_API_KEY=replace-with-malware-scanner-api-key
